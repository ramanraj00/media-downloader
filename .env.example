# Application Environment
NODE_ENV=production

# Database & Redis (Defaults match docker-compose.yml)
DATABASE_URL=postgres://postgres:password@postgres:5432/mediabot
REDIS_URL=redis://redis:6379

# Internal Service URLs
API_URL=http://api:3000
COBALT_URL=http://cobalt:9000/

# File Storage path (mapped to Docker volume)
ARTIFACTS_DIR=/app/artifacts

# Secrets (You MUST provide this)
BOT_TOKEN=your_telegram_bot_token_here
